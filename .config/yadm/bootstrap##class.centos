#!/bin/sh
set -e
# ====================================
# Repos needed for extra packages
# ====================================

# EPEL provides: ranger, fzf, ripgrep, bat, jq, p7zip, ImageMagick, etc.
sudo dnf install -y epel-release
sudo dnf makecache

script_path=`( cd "$(dirname "$0")" && pwd -P )`

# ====================================
# Install packages
# ====================================

sudo dnf install -y \
    zsh tmux ranger \
    unzip wget \
    fzf \
    neovim \
    ripgrep bat jq p7zip poppler-utils ImageMagick

# zoxide (not packaged in EPEL: use official installer, same as arch/debian variants)
curl -sS https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | bash

# ranger plugins
git clone https://github.com/jchook/ranger-zoxide.git ~/.config/ranger/plugins/zoxide || true
git clone https://github.com/joouha/ranger_tmux.git ~/.config/ranger/plugins/ranger_tmux || true

# tmux plugins
git clone https://github.com/wfxr/tmux-net-speed.git ~/.config/tmux/tmux-net-speed || true
git clone https://github.com/tmux-plugins/tmux-prefix-highlight.git ~/.config/tmux/tmux-prefix-highlight || true

# lazy.nvim will auto-bootstrap on first nvim run

# ====================================
# oh-my-zsh
# ====================================
yes | sh -c "$(wget -O- https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
git clone https://github.com/zsh-users/zsh-autosuggestions ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions || true

cd $script_path
for theme in `ls *.zsh-theme`; do
	ln -sr ~/.config/yadm/$theme ~/.oh-my-zsh/custom/themes/$theme
done
mkdir -p ~/.oh-my-zsh/custom/plugins/elapsed-time
ln -sr ~/.config/yadm/elapsed-time.plugin.zsh ~/.oh-my-zsh/custom/plugins/elapsed-time/.

if [[ -f ~/.zshrc.pre-oh-my-zsh ]]; then
	rm ~/.zshrc
	mv ~/.zshrc.pre-oh-my-zsh ~/.zshrc
fi
sudo chsh -s /bin/zsh ${USER}

# ====================================
# Yazi
# ====================================
# Not packaged for RPM/EPEL: install prebuilt binary from GitHub releases.
YAZI_VERSION=$(curl -s https://api.github.com/repos/sxyazi/yazi/releases/latest | grep -Po '"tag_name": "\K[^"]*')
curl -sSL "https://github.com/sxyazi/yazi/releases/download/${YAZI_VERSION}/yazi-x86_64-unknown-linux-gnu.zip" -o /tmp/yazi.zip
unzip -o /tmp/yazi.zip -d /tmp/yazi
sudo install -m 755 /tmp/yazi/yazi-x86_64-unknown-linux-gnu/yazi /usr/local/bin/yazi
sudo install -m 755 /tmp/yazi/yazi-x86_64-unknown-linux-gnu/ya /usr/local/bin/ya
rm -rf /tmp/yazi /tmp/yazi.zip

mkdir -p ~/.config/yazi

# flavors (i.e. themes)
ya pkg add dangooddd/kanagawa
ya pkg add Chromium-3-Oxide/everforest-medium

# plugins
ya pkg add yazi-rs/plugins:full-border
ya pkg add yazi-rs/plugins:git
ya pkg add yazi-rs/plugins:chmod
ya pkg add yazi-rs/plugins:mime-ext
ya pkg add boydaihungst/pref-by-location

# ====================================
# Other programs
# ====================================
# ncdu and duf: both available via EPEL
xargs -a ~/.config/yadm/program_list sudo dnf install -y

echo "=============="
echo "==== DONE ===="
echo "=============="
